<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ backup/transfer rules. Exclude everything: no cloud/device
     transfer of recordings, database, or settings. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
