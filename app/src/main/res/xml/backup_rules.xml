<?xml version="1.0" encoding="utf-8"?>
<!--
  Privacy: this app holds highly sensitive call recordings. Backup is disabled
  at the manifest level (allowBackup=false); this file documents that nothing
  should ever be included in a cloud/adb backup.
-->
<full-backup-content>
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
</full-backup-content>
