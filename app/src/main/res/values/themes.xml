<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Base XML theme. Colors are driven by the Compose theme at runtime; this
      only needs to be a no-action-bar theme. Based on a platform theme so we do
      not need to depend on the Material Components view library.
    -->
    <style name="Theme.PersonalCallRecorder" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/window_background</item>
    </style>
</resources>
